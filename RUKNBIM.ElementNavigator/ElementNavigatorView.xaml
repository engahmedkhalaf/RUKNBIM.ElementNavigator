<UserControl x:Class="RUKNBIM.ElementNavigator.ElementNavigatorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:RUKNBIM.ElementNavigator"
             mc:Ignorable="d"
             d:DesignHeight="600" d:DesignWidth="320"
             Background="#F5F5F5">
    <UserControl.Resources>
        <Style TargetType="Button">
            <Setter Property="Height" Value="28" />
            <Setter Property="Margin" Value="0,2,0,2" />
        </Style>
        <Style x:Key="InfoLabel" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="#555" />
        </Style>
        <Style x:Key="InfoValue" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#111" />
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TabControl Grid.Row="0" Margin="5">
            <!-- ============ SEARCH TAB ============ -->
            <TabItem Header="Search">
                <Grid Margin="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Text="Paste Revit Element IDs (newline or comma separated):"
                               TextWrapping="Wrap" FontWeight="Bold" Margin="0,0,0,5"/>

                    <TextBox Grid.Row="1"
                             Text="{Binding ElementIdsInput, UpdateSourceTrigger=PropertyChanged}"
                             AcceptsReturn="True"
                             VerticalScrollBarVisibility="Auto"
                             MinHeight="120"
                             Margin="0,0,0,8"/>

                    <Border Grid.Row="2" Background="#FFF8E1" BorderBrush="#FFC107"
                            BorderThickness="1" CornerRadius="4" Margin="0,0,0,8">
                        <TextBlock Text="{Binding StatusMessage}" Margin="6,4" TextWrapping="Wrap"/>
                    </Border>

                    <StackPanel Grid.Row="3" Orientation="Vertical" Margin="0,0,0,8">
                        <CheckBox Content="Isolate Selected Elements"
                                  IsChecked="{Binding IsolateSelected}" Margin="0,0,0,4"/>
                        <CheckBox Content="Zoom to Selected Elements"
                                  IsChecked="{Binding ZoomToSelected}" />
                    </StackPanel>

                    <StackPanel Grid.Row="4" Orientation="Vertical">
                        <Button Content="Search &amp; Highlight"
                                Command="{Binding SearchCommand}"
                                Background="#00897B" Foreground="White" Height="32"/>
                        <Button Content="Restore Full Model"
                                Command="{Binding RestoreFullModelCommand}" />
                        <Grid Margin="0,4,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="5" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="0" Content="Import Excel"
                                    Command="{Binding ImportExcelCommand}" />
                            <Button Grid.Column="2" Content="Export Report"
                                    Command="{Binding ExportReportCommand}" />
                        </Grid>
                    </StackPanel>
                </Grid>
            </TabItem>

            <!-- ============ RESULTS TAB ============ -->
            <TabItem Header="Results">
                <Grid Margin="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Border Background="White" BorderBrush="#DDD" BorderThickness="1"
                            CornerRadius="4" Padding="8" Margin="0,0,0,8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Found" Style="{StaticResource InfoLabel}"/>
                                <TextBlock Text="{Binding FoundCount}" FontSize="22"
                                           Foreground="#00897B" FontWeight="Bold"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="Missing" Style="{StaticResource InfoLabel}"/>
                                <TextBlock Text="{Binding MissingCount}" FontSize="22"
                                           Foreground="#C62828" FontWeight="Bold"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <TextBlock Grid.Row="1" Text="Found IDs" FontWeight="Bold" Margin="0,0,0,4"/>
                    <ListBox Grid.Row="2" ItemsSource="{Binding FoundIds}"
                             MinHeight="80" Margin="0,0,0,8"/>

                    <TextBlock Grid.Row="3" Text="Missing IDs" FontWeight="Bold" Margin="0,0,0,4"/>
                    <ListBox Grid.Row="4" ItemsSource="{Binding MissingIds}"
                             MinHeight="80" Margin="0,0,0,8"/>

                    <Button Grid.Row="5" Content="Export Report"
                            Command="{Binding ExportReportCommand}" />
                </Grid>
            </TabItem>

            <!-- ============ ABOUT TAB ============ -->
            <TabItem Header="About">
                <Grid Margin="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Text="RUKNBIM Element Navigator"
                               FontSize="16" FontWeight="Bold" Foreground="#00695C"
                               Margin="0,0,0,8"/>

                    <Border Grid.Row="1" Background="#0D1B2A" BorderBrush="#1B263B"
                            BorderThickness="1" CornerRadius="4" Padding="12">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Version: " FontWeight="Bold" Foreground="White"/>
                                <TextBlock Text="{Binding Version}" Foreground="White"/>
                            </StackPanel>

                            <TextBlock Text="{Binding UpdateStatus}"
                                       Foreground="{Binding UpdateStatusBrush}"
                                       FontWeight="SemiBold"
                                       Margin="0,2,0,10"/>

                            <TextBlock Foreground="#E0E0E0">
                                <Run Text="Prepared by: " FontWeight="Bold"/>
                                <Run Text="Ahmed Khalaf (BIM Manager)"/>
                            </TextBlock>
                            <TextBlock Foreground="#E0E0E0" Margin="0,2,0,10">
                                <Run Text="Mobile: " FontWeight="Bold"/>
                                <Run Text="+966542554127"/>
                            </TextBlock>

                            <TextBlock Foreground="#E0E0E0">
                                <Run Text="Contact Support: " FontWeight="Bold"/>
                                <Hyperlink NavigateUri="mailto:engkhalaf7@gmail.com"
                                           Foreground="#4FC3F7"
                                           RequestNavigate="Hyperlink_RequestNavigate">
                                    engkhalaf7@gmail.com
                                </Hyperlink>
                            </TextBlock>
                            <TextBlock Foreground="#E0E0E0" Margin="0,2,0,0">
                                <Run Text="Website: " FontWeight="Bold"/>
                                <Hyperlink NavigateUri="https://rukn-bim-website-opka.vercel.app/#top"
                                           Foreground="#4FC3F7"
                                           RequestNavigate="Hyperlink_RequestNavigate">
                                    rukn-bim-website-opka.vercel.app
                                </Hyperlink>
                            </TextBlock>
                        </StackPanel>
                    </Border>

                    <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Center"
                                Margin="0,8,0,0">
                        <Button Content="About" Width="80" Command="{Binding AboutCommand}" Margin="2"/>
                        <Button Content="Help" Width="80" Command="{Binding HelpCommand}" Margin="2"/>
                        <Button Content="Update" Width="80" Command="{Binding UpdateCommand}" Margin="2"/>
                    </StackPanel>
                </Grid>
            </TabItem>
        </TabControl>

        <!-- Status bar -->
        <Border Grid.Row="1" Background="#ECEFF1" BorderBrush="#CFD8DC" BorderThickness="0,1,0,0">
            <TextBlock Text="{Binding StatusMessage}" Margin="8,4" Foreground="#37474F"/>
        </Border>

        <!-- Footer -->
        <Border Grid.Row="2" Background="#00695C" Padding="6">
            <StackPanel HorizontalAlignment="Center">
                <TextBlock Text="RUKNBIM API" Foreground="White" FontWeight="Bold"
                           HorizontalAlignment="Center"/>
                <TextBlock Text="Empowering BIM Automation" Foreground="#B2DFDB"
                           FontSize="10" HorizontalAlignment="Center"/>
                <TextBlock Foreground="#B2DFDB" FontSize="10" HorizontalAlignment="Center">
                    <Hyperlink NavigateUri="https://rukn-bim-website-opka.vercel.app/#top"
                               Foreground="#FFEB3B"
                               RequestNavigate="Hyperlink_RequestNavigate">
                        rukn-bim-website-opka.vercel.app
                    </Hyperlink>
                </TextBlock>
                <TextBlock Text="Prepared by Ahmed Khalaf — BIM Manager"
                           Foreground="#B2DFDB" FontSize="10"
                           HorizontalAlignment="Center" Margin="0,4,0,0"/>
                <TextBlock Text="Mobile: 0542554127"
                           Foreground="#B2DFDB" FontSize="10"
                           HorizontalAlignment="Center"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
